{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "platform", "status", "node", "electron", "files", "packages", "fitModes", "missing"],
  "properties": {
    "schemaVersion": {"const": 2}, "platform": {"const": "win32-x64"}, "status": {"enum": ["blocked", "ready"]},
    "node": {"type": "object", "additionalProperties": false, "required": ["version", "abi", "archiveSha256", "executable", "args"], "properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "abi": {"type": "string", "pattern": "^[0-9]+$"}, "archiveSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "executable": {"const": "runtime/node.exe"}, "args": {"const": ["runtime/mcp.cjs"]}}},
    "electron": {"type": "object", "additionalProperties": false, "required": ["version", "abi", "integrity"], "properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "abi": {"type": "string", "pattern": "^[0-9]+$"}, "integrity": {"type": "string", "minLength": 1}}},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "role", "consumer", "abi", "arch", "licensePath", "qualificationEvidence"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}, "role": {"enum": ["node", "mcp-entry", "dependency", "native", "license", "fit-resource", "evidence"]}, "consumer": {"enum": ["standalone-node", "electron", "none"]}, "abi": {"type": "string"}, "arch": {"const": "x64"}, "licensePath": {"type": "string"}, "qualificationEvidence": {"type": "string"}}}},
    "packages": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "packageJson", "dependencies"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string"}, "packageJson": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string"}}}}},
    "fitModes": {"type": "object", "additionalProperties": false, "required": ["cover", "contain", "stretch"], "properties": {"cover": {"type": "string"}, "contain": {"type": "string"}, "stretch": {"type": "string"}}},
    "missing": {"type": "array", "items": {"type": "string"}}
  }
}
