{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "object",
      "properties": {
        "rootId": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "rootId",
        "relativePath",
        "sha256"
      ],
      "additionalProperties": false
    },
    "workingTemplateRelativePath": {
      "type": "string",
      "minLength": 1
    },
    "closureEntries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "original": {
            "type": "object",
            "properties": {
              "rootId": {
                "type": "string",
                "minLength": 1
              },
              "relativePath": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "rootId",
              "relativePath",
              "sha256"
            ],
            "additionalProperties": false
          },
          "ownedRelativePath": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "minimum": 1
          },
          "originalBeforeSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "originalAfterSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "copyBeforeSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "copyAfterSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "template",
              "linked"
            ]
          }
        },
        "required": [
          "original",
          "ownedRelativePath",
          "bytes",
          "originalBeforeSha256",
          "originalAfterSha256",
          "copyBeforeSha256",
          "copyAfterSha256",
          "identity",
          "sourceKind"
        ],
        "additionalProperties": false
      }
    },
    "observedLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parentOwnedRelativePath": {
            "type": "string",
            "minLength": 1
          },
          "childOwnedRelativePath": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "parentOwnedRelativePath",
          "childOwnedRelativePath",
          "identity"
        ],
        "additionalProperties": false
      }
    },
    "documentTrace": {
      "type": "object",
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "relativePath",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "assetId",
    "attempt",
    "operationId",
    "template",
    "workingTemplateRelativePath",
    "closureEntries",
    "observedLinks",
    "documentTrace"
  ],
  "additionalProperties": false,
  "x-runtime-only-invariants": [
    "candidate existence, role and document-route compatibility",
    "source/profile/backend/tool-schema/fit-mode and current-attempt binding",
    "manifest path existence, digest and byte verification, including digestWithoutSelfHash",
    "review policy digest, exact evidence closure and reviewer provenance qualification",
    "canonical filesystem containment and symlink/reparse-point rejection",
    "source/dependency byte hashes, complete discovered closure and actual opened-copy proof",
    "exact attempt/operation identity, settled mutation, owned-document cleanup and OS-lock release proof"
  ],
  "$id": "@ne-psd/contracts/schema/v2/template-closure-proof.json"
}
