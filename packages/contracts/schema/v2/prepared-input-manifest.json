{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "stagingDirectory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "profileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "template": {
          "type": "object",
          "properties": {
            "rootId": {
              "type": "string",
              "minLength": 1
            },
            "relativePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "rootId",
            "relativePath",
            "sha256"
          ],
          "additionalProperties": false
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRootId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRootPath": {
          "type": "string",
          "minLength": 1
        },
        "sourceRootIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scratchDirectory": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "prepared"
        },
        "source": {
          "type": "object",
          "properties": {
            "original": {
              "type": "object",
              "properties": {
                "rootId": {
                  "type": "string",
                  "minLength": 1
                },
                "relativePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "rootId",
                "relativePath",
                "sha256"
              ],
              "additionalProperties": false
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            }
          },
          "required": [
            "original",
            "bytes"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "original": {
                "type": "object",
                "properties": {
                  "rootId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "relativePath": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "rootId",
                  "relativePath",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "minimum": 1
              },
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "sourceKind": {
                "type": "string",
                "const": "linked"
              }
            },
            "required": [
              "original",
              "bytes",
              "identity",
              "sourceKind"
            ],
            "additionalProperties": false
          }
        },
        "closureComplete": {
          "type": "boolean",
          "const": true
        },
        "closureProof": {
          "type": "object",
          "properties": {
            "relativePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "relativePath",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "assetId",
        "attempt",
        "operationId",
        "stagingDirectory",
        "profileSha256",
        "template",
        "sourceSha256",
        "sourceRootId",
        "sourceRootPath",
        "sourceRootIdentity",
        "scratchDirectory",
        "status",
        "source",
        "dependencies",
        "closureComplete",
        "closureProof"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "stagingDirectory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "profileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "template": {
          "type": "object",
          "properties": {
            "rootId": {
              "type": "string",
              "minLength": 1
            },
            "relativePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "rootId",
            "relativePath",
            "sha256"
          ],
          "additionalProperties": false
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRootId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRootPath": {
          "type": "string",
          "minLength": 1
        },
        "sourceRootIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scratchDirectory": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "blocked"
        },
        "errors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "enum": [
                  "validation",
                  "capability",
                  "transient",
                  "ambiguousState",
                  "review",
                  "cancelled"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "evidencePaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "code",
              "category",
              "message",
              "retryable",
              "evidencePaths"
            ],
            "additionalProperties": false
          }
        },
        "evidencePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "assetId",
        "attempt",
        "operationId",
        "stagingDirectory",
        "profileSha256",
        "template",
        "sourceSha256",
        "sourceRootId",
        "sourceRootPath",
        "sourceRootIdentity",
        "scratchDirectory",
        "status",
        "errors",
        "evidencePaths"
      ],
      "additionalProperties": false
    }
  ],
  "x-runtime-only-invariants": [
    "candidate existence, role and document-route compatibility",
    "source/profile/backend/tool-schema/fit-mode and current-attempt binding",
    "manifest path existence, digest and byte verification, including digestWithoutSelfHash",
    "review policy digest, exact evidence closure and reviewer provenance qualification",
    "canonical filesystem containment and symlink/reparse-point rejection",
    "source/dependency byte hashes, complete discovered closure and actual opened-copy proof",
    "exact attempt/operation identity, settled mutation, owned-document cleanup and OS-lock release proof"
  ],
  "$id": "@ne-psd/contracts/schema/v2/prepared-input-manifest.json"
}
