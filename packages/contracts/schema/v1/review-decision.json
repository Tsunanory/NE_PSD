{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "evidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "promptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "modelProvenance": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            },
            "artifactSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "runtimeVersion": {
              "type": "string",
              "minLength": 1
            },
            "chatTemplateSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "artifactSha256",
            "runtimeVersion",
            "chatTemplateSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "remote"
            },
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "luna"
              ]
            },
            "modelId": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "qualificationEvidencePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            }
          },
          "required": [
            "kind",
            "provider",
            "modelId",
            "revision",
            "qualificationEvidencePath"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reviewerVersion": {
      "type": "string",
      "minLength": 1
    },
    "reviewPolicySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "blocked"
      ]
    },
    "variantChecks": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "verdict": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "variantId",
            "verdict",
            "evidenceRefs",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "verdict": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "variantId",
            "verdict",
            "evidenceRefs",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "verdict": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "variantId",
            "verdict",
            "evidenceRefs",
            "reason"
          ],
          "additionalProperties": false
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "requirementId",
          "result",
          "evidenceRefs",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "code",
          "evidenceRefs",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "reviewId",
    "jobId",
    "assetId",
    "attempt",
    "evidenceSha256",
    "sessionId",
    "promptSha256",
    "modelId",
    "modelProvenance",
    "reviewerVersion",
    "reviewPolicySha256",
    "verdict",
    "variantChecks",
    "checks",
    "findings"
  ],
  "additionalProperties": false,
  "$id": "@ne-psd/contracts/schema/v1/review-decision.json",
  "x-schema-version": 1,
  "x-runtime-only-invariants": [
    "candidate existence, role and document-route compatibility",
    "source/profile/backend/tool-schema/fit-mode and current-attempt binding",
    "manifest path existence, digest and byte verification, including digestWithoutSelfHash",
    "review policy digest, exact evidence closure and reviewer provenance qualification"
  ]
}
