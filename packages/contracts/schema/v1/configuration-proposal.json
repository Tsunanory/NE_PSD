{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "inspectionId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "blocked"
      ]
    },
    "targets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetCandidateId": {
            "type": "string",
            "minLength": 1
          },
          "referenceCandidateId": {
            "type": "string",
            "minLength": 1
          },
          "inputCandidateId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "targetCandidateId",
          "referenceCandidateId",
          "inputCandidateId"
        ],
        "additionalProperties": false
      }
    },
    "variants": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "groupCandidateId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "groupCandidateId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "groupCandidateId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "groupCandidateId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "groupCandidateId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "groupCandidateId"
          ],
          "additionalProperties": false
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "fitMode": {
      "type": "string",
      "enum": [
        "cover",
        "contain",
        "stretch"
      ]
    },
    "output": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "jpeg",
                "png"
              ]
            },
            "quality": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "colorSpace": {
              "type": "string",
              "const": "sRGB"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            }
          },
          "required": [
            "format",
            "quality",
            "colorSpace",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "missingFields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "claim",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "explanation": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "inspectionId",
    "status",
    "targets",
    "variants",
    "fitMode",
    "output",
    "missingFields",
    "facts",
    "explanation"
  ],
  "additionalProperties": false,
  "$id": "@ne-psd/contracts/schema/v1/configuration-proposal.json",
  "x-schema-version": 1,
  "x-runtime-only-invariants": [
    "candidate existence, role and document-route compatibility",
    "source/profile/backend/tool-schema/fit-mode and current-attempt binding",
    "manifest path existence, digest and byte verification, including digestWithoutSelfHash",
    "review policy digest, exact evidence closure and reviewer provenance qualification"
  ]
}
