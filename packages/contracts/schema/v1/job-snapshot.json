{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "running",
        "pausing",
        "paused",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "complete": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blocked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "rendering",
              "reviewing",
              "readyToCommit",
              "complete",
              "failed",
              "blocked",
              "cancelled"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "validation",
                      "capability",
                      "transient",
                      "ambiguousState",
                      "review",
                      "cancelled"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "evidencePaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "code",
                  "category",
                  "message",
                  "retryable",
                  "evidencePaths"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "assetId",
          "status",
          "attempt",
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "jobId",
    "state",
    "total",
    "complete",
    "failed",
    "blocked",
    "assets"
  ],
  "additionalProperties": false,
  "$id": "@ne-psd/contracts/schema/v1/job-snapshot.json",
  "x-schema-version": 1
}
