{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "minimum": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "renderEvidence",
              "artifact",
              "trace",
              "check",
              "humanAttestation",
              "imageInput"
            ]
          }
        },
        "required": [
          "relativePath",
          "sha256",
          "bytes",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "visionInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "source",
              "reference",
              "output",
              "detail"
            ]
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "minimum": 1
          },
          "variantId": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "1",
                  "2",
                  "3"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "derivedFromSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "crop": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "number"
                  },
                  "top": {
                    "type": "number"
                  },
                  "right": {
                    "type": "number"
                  },
                  "bottom": {
                    "type": "number"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "role",
          "relativePath",
          "sha256",
          "width",
          "height",
          "variantId",
          "derivedFromSha256",
          "crop"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "assetId",
    "attempt",
    "files",
    "visionInputs"
  ],
  "additionalProperties": false,
  "$id": "@ne-psd/contracts/schema/v1/evidence-bundle-manifest.json",
  "x-schema-version": 1,
  "x-runtime-only-invariants": [
    "candidate existence, role and document-route compatibility",
    "source/profile/backend/tool-schema/fit-mode and current-attempt binding",
    "manifest path existence, digest and byte verification, including digestWithoutSelfHash",
    "review policy digest, exact evidence closure and reviewer provenance qualification",
    "manifest relativePath uniqueness and self-hash exclusion"
  ]
}
