{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "toolSchemaSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "documentRoute": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "group",
                          "smartObject",
                          "pixel",
                          "shape"
                        ]
                      },
                      "fingerprint": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name",
                      "kind",
                      "fingerprint"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "layerPath": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "group",
                        "smartObject",
                        "pixel",
                        "shape"
                      ]
                    },
                    "fingerprint": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "kind",
                    "fingerprint"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "documentRoute",
              "layerPath"
            ],
            "additionalProperties": false
          },
          "reference": {
            "type": "object",
            "properties": {
              "left": {
                "type": "number"
              },
              "top": {
                "type": "number"
              },
              "right": {
                "type": "number"
              },
              "bottom": {
                "type": "number"
              }
            },
            "required": [
              "left",
              "top",
              "right",
              "bottom"
            ],
            "additionalProperties": false
          },
          "placed": {
            "type": "object",
            "properties": {
              "left": {
                "type": "number"
              },
              "top": {
                "type": "number"
              },
              "right": {
                "type": "number"
              },
              "bottom": {
                "type": "number"
              }
            },
            "required": [
              "left",
              "top",
              "right",
              "bottom"
            ],
            "additionalProperties": false
          },
          "fitMode": {
            "type": "string",
            "enum": [
              "cover",
              "contain",
              "stretch"
            ]
          },
          "clipped": {
            "type": "boolean"
          },
          "adjacentToReference": {
            "type": "boolean"
          }
        },
        "required": [
          "target",
          "reference",
          "placed",
          "fitMode",
          "clipped",
          "adjacentToReference"
        ],
        "additionalProperties": false
      }
    },
    "visibility": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3"
            ]
          },
          "visibleVariantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            }
          }
        },
        "required": [
          "variantId",
          "visibleVariantIds"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "colorSpace": {
              "type": "string",
              "const": "sRGB"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "format": {
              "type": "string",
              "enum": [
                "jpeg",
                "png"
              ]
            }
          },
          "required": [
            "variantId",
            "path",
            "sha256",
            "bytes",
            "colorSpace",
            "width",
            "height",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "colorSpace": {
              "type": "string",
              "const": "sRGB"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "format": {
              "type": "string",
              "enum": [
                "jpeg",
                "png"
              ]
            }
          },
          "required": [
            "variantId",
            "path",
            "sha256",
            "bytes",
            "colorSpace",
            "width",
            "height",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "colorSpace": {
              "type": "string",
              "const": "sRGB"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "format": {
              "type": "string",
              "enum": [
                "jpeg",
                "png"
              ]
            }
          },
          "required": [
            "variantId",
            "path",
            "sha256",
            "bytes",
            "colorSpace",
            "width",
            "height",
            "format"
          ],
          "additionalProperties": false
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidencePath": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "passed",
          "evidencePath"
        ],
        "additionalProperties": false
      }
    },
    "documentTracePath": {
      "type": "string",
      "minLength": 1
    },
    "toolTracePath": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "assetId",
    "attempt",
    "profileSha256",
    "sourceSha256",
    "toolSchemaSha256",
    "geometry",
    "visibility",
    "artifacts",
    "checks",
    "documentTracePath",
    "toolTracePath"
  ],
  "additionalProperties": false,
  "$id": "@ne-psd/contracts/schema/v1/render-evidence.json",
  "x-schema-version": 1
}
