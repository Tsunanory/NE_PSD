{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "preAttestationContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "toolSchemaSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewPolicySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "colorSpace": {
              "type": "string",
              "const": "sRGB"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "jpeg",
                "png"
              ]
            }
          },
          "required": [
            "variantId",
            "path",
            "sha256",
            "bytes",
            "colorSpace",
            "width",
            "height",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "colorSpace": {
              "type": "string",
              "const": "sRGB"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "jpeg",
                "png"
              ]
            }
          },
          "required": [
            "variantId",
            "path",
            "sha256",
            "bytes",
            "colorSpace",
            "width",
            "height",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variantId": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "colorSpace": {
              "type": "string",
              "const": "sRGB"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "jpeg",
                "png"
              ]
            }
          },
          "required": [
            "variantId",
            "path",
            "sha256",
            "bytes",
            "colorSpace",
            "width",
            "height",
            "format"
          ],
          "additionalProperties": false
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "contactSheet": {
      "type": "object",
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "relativePath",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestId",
    "jobId",
    "assetId",
    "attempt",
    "preAttestationContentSha256",
    "profileSha256",
    "sourceSha256",
    "toolSchemaSha256",
    "reviewPolicySha256",
    "artifacts",
    "contactSheet"
  ],
  "additionalProperties": false,
  "$id": "@ne-psd/contracts/schema/v1/visual-review-request.json",
  "x-schema-version": 1,
  "x-runtime-only-invariants": [
    "candidate existence, role and document-route compatibility",
    "source/profile/backend/tool-schema/fit-mode and current-attempt binding",
    "manifest path existence, digest and byte verification, including digestWithoutSelfHash",
    "review policy digest, exact evidence closure and reviewer provenance qualification"
  ]
}
